# Example environment configuration for Harshanth R Portfolio
# Copy this file to .env and configure your secret values

VITE_ADMIN_PASSWORD=your_secure_master_password_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here

# GitHub Personal Access Token (Server/Local only - not exposed in client bundle)
GITHUB_TOKEN=your_github_pat_here
